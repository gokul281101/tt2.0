# Note: For local development, Vite proxies '/api' requests to http://localhost:5001 automatically.
# You do not need to configure any environment variables locally.
#
# If you choose to connect directly to the backend URL without using the vercel.json rewrite proxy,
# you can define the backend URL here:
VITE_API_URL=https://your-render-backend-url.onrender.com/api
